# URL of your Render free application to keep awake (comma-separated if multiple)
TARGET_URLS=https://your-app-name.onrender.com

# Timeout in milliseconds to allow sleeping Render apps to wake up (default: 90000ms = 90s)
TIMEOUT_MS=90000

# Number of retry attempts if request fails
MAX_RETRIES=3

# Poke mode: "browser" (uses Playwright Chromium for realistic DOM rendering) or "request" (ultra-fast HTTP ping)
POKE_MODE=browser

# Interval in minutes when running in daemon mode (default: 12 minutes, Render spins down at 15m)
DAEMON_INTERVAL_MINUTES=12
